if not httpAvailable then
	setStatus("This executor does not expose HTTP requests, so it cannot listen.", THEME.red)
	print("[Server Joiner] this executor does not expose HTTP requests")
	return
end

if CONFIG.RUN_SESSION_AFTER_JOIN then
	if queueOnTeleport then
		print("[Server Joiner] " .. queueName .. " found: the trading session will run in the host's server")
	else
		print("[Server Joiner] this executor has no queue_on_teleport, so nothing can run after the teleport")
		setStatus("This executor cannot run a script after the teleport, so the host's trade cannot be answered.", THEME.amber)
	end
end

pcall(function()
	TeleportService.TeleportInitFailed:Connect(function(player, result, messageText)
			if player ~= Players.LocalPlayer or not state.pending then
				return
			end
			state.pending = false
			clearQueuedScript()
			setStatus("Teleport failed: " .. tostring(messageText) .. " (" .. tostring(result) .. ")", THEME.red)
			offerFallback(state.info)
		end)
	end)

setInfo(nil)

spawnThread(function()
	while state.running do
		local hosts, status = findLiveHosts()

		if hosts then
			local latest = hosts[#hosts]
			if latest then
				state.info = latest
				setInfo(latest)
				if CONFIG.AUTO_JOIN then
					attemptJoin(latest)
				else
					setStatus("Host found - press Join now.", THEME.green)
				end
			else
				state.info = nil
				setInfo(nil)
				setStatus("No host is running right now - waiting for one to start...", THEME.amber)
			end
		elseif status == 429 then
			setStatus("Relay is rate limiting this network. Slowing down...", THEME.amber)
			waitSeconds(10)
		else
			setStatus("Could not reach the relay (error " .. tostring(status) .. "). Retrying...", THEME.red)
		end

		waitSeconds(CONFIG.POLL_SECONDS)
	end
end)

