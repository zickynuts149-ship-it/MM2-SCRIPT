--[[
	Trade - JOINER

	Run this in the same Roblox server as the person running host.lua. Nothing
	joins anybody: both of you are already here.

	What this side does, every cycle:
	  1. Takes the other player in this server as the host - no handshake, no
	     waiting for the relay to say who is who (CONFIG.HOST overrides it).
	  2. Sees the trade request in its own UI (or hears about it on the relay),
	     and fires Trade.AcceptRequest 1s later.
	  3. Watches its own trade window for the host's items, then presses accept 1s
	     after the host's moment (6s after the last item), checks the game really
	     took it, and confirms 1s later.
	  4. Hears that the host is finished, or notices that it went quiet.

	The trade window is never hidden, disabled or deleted by this script.
	Nothing here waits for a relay message to move on: the relay is a helper,
	and every step is timed off the trade window and the clock.
]]

--------------------------------------------------------------------------
-- Configuration
--------------------------------------------------------------------------

local CONFIG = {
	-- Must match ROOM in host.lua.
	ROOM = "fbshare1",

	-- Message relay. ntfy.sh needs no signup.
	RELAY_URL = "https://ntfy.sh",

	-- nil -> the host is the other player in this server. Set to a Roblox
	-- username to only ever talk to that person.
	HOST = nil,

	-- The trade handshake, in seconds. host.lua uses the same numbers.
	REQUEST_ACCEPT_DELAY = 1,      -- the request arrived -> AcceptRequest
	ACCEPT_DELAY_SECONDS = 6,      -- the host's last item landed -> accept
	ACCEPT_GO_DELAY_SECONDS = 1,   -- the host said "accept now" -> press accept
	CONFIRM_DELAY_SECONDS = 1,     -- press accept -> press confirm
	ITEMS_WAIT_SECONDS = 12,       -- longest wait for the host's items to land
	-- The link: the same transport the ServerChat script uses. The channel name
	-- comes from this server's JobId, so only clients in THIS server hear each
	-- other. ntfy.sh allows 60 requests as a burst, then about one per 10s.
	LINK_POLL_SECONDS = 10,        -- how often the channel is read
	LINK_START_POLL_SECONDS = 1.5,   -- during the first moments: fast, so CONNECTED happens at once
	LINK_START_POLL_WINDOW = 20,   -- how long that fast pace lasts
	LINK_MAX_POLL_SECONDS = 25,    -- the most it backs off to while the relay refuses
	LINK_HELLO_SECONDS = 12,       -- how often to say hello until the host's script answers
	LINK_HELLO_RETRY_SECONDS = 4,  -- a refused hello is retried this soon
	LINK_KEEPALIVE_SECONDS = 60,   -- how often after that
	WINDOW_WAIT_SECONDS = 8,       -- how long the trade window may take to open
}

