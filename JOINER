-- The file's own currentJobId() is declared further down, so this copy reads
-- the job straight from the client instead of relying on hoisting.
local function jobIdNow()
	local ok, job = pcall(function()
		return game.JobId
	end)
	if ok and type(job) == "string" then
		return job
	end
	return ""
end

-- Builds the session script. `withNextGeneration` embeds one more copy of the
-- same script as hex, so the copy that runs in the next server can arm another
-- one after that. Hex means an odd username or URL can never break out of the
-- string, and the copy is only ever produced by this function.
local function buildSessionSource(withNextGeneration)
	local base = SESSION_TEMPLATE

	local function fill(source)
		source = source:gsub("__RELAY_HEX__", function()
			return toHex(relayBase)
		end)
		source = source:gsub("__SYNC_TOPIC_HEX__", function()
			return toHex(syncTopic)
		end)
		source = source:gsub("__SERVER_TOPIC_HEX__", function()
			return toHex(topic)
		end)
		source = source:gsub("__HOST_USER_HEX__", function()
			return toHex(hostUsername)
		end)
		source = source:gsub("__HOST_DISPLAY_HEX__", function()
			return toHex(hostDisplay)
		end)
		source = source:gsub("__JOB_HEX__", function()
			return toHex(jobIdNow())
		end)
		source = source:gsub("__REQUEST_DELAY__", function()
			return tostring(CONFIG.REQUEST_ACCEPT_DELAY)
		end)
		source = source:gsub("__ITEMS_FALLBACK__", function()
			return tostring(CONFIG.ITEMS_FALLBACK_SECONDS)
		end)
		source = source:gsub("__ACCEPT_DELAY__", function()
			return tostring(CONFIG.ACCEPT_DELAY_SECONDS)
		end)
		source = source:gsub("__CONFIRM_DELAY__", function()
			return tostring(CONFIG.CONFIRM_DELAY_SECONDS)
		end)
		source = source:gsub("__ACK_WAIT__", function()
			return tostring(CONFIG.ACK_WAIT_SECONDS)
		end)
		source = source:gsub("__SYNC_POLL__", function()
			return tostring(CONFIG.SYNC_POLL_SECONDS)
		end)
		source = source:gsub("__REQUEST_TIMEOUT__", function()
			return tostring(CONFIG.REQUEST_TIMEOUT_SECONDS)
		end)
		source = source:gsub("__WINDOW_WAIT__", function()
			return tostring(CONFIG.WINDOW_WAIT_SECONDS)
		end)
		return source
	end

	local nextSource = ""
	if withNextGeneration then
		nextSource = toHex(fill(base))
	end

	local source = fill(base)
	source = source:gsub("__SPARE_HEX__", function()
		return nextSource
	end)
	return source
end

-- The copy queued now; the spare is what gets queued again from inside it.
local function buildSession()
	return buildSessionSource(true)
end

local function queueSession()
	if not queueOnTeleport then
		return false
	end
	return pcall(queueOnTeleport, buildSession())
end

local function clearQueuedScript()
	if not queueOnTeleport then
		return
	end
	-- An empty script replaces anything still queued, so a teleport that never
	-- happened does not fire the session on some later, unrelated join.
	pcall(queueOnTeleport, "")
end

-- Running the session where we already are, e.g. joiner.lua started inside
-- the host's server or run again after a finished session.
local sessionRun = { started = false }

local function findLoadstring()
	local candidates = {
		rawget(_G, "loadstring"),
		rawget(_G, "load"),
	}
	if type(getgenv) == "function" then
		local ok, environment = pcall(getgenv)
		if ok and type(environment) == "table" then
			candidates[#candidates + 1] = rawget(environment, "loadstring")
			candidates[#candidates + 1] = rawget(environment, "load")
		end
	end
	for _, candidate in ipairs(candidates) do
		if type(candidate) == "function" then
			return candidate
		end
	end
	return nil
end

local function startSessionHere()
	if sessionRun.started then
		return false
	end
	local loader = findLoadstring()
	if not loader then
		print("[Server Joiner] this executor has no loadstring, so the session cannot be started here")
		return false
	end
	local chunk, err = loader(buildSession())
	if type(chunk) ~= "function" then
		print("[Server Joiner] could not build the session: " .. tostring(err))
		return false
	end
	sessionRun.started = true
	print("[Server Joiner] starting the session here for " .. hostUsername)
	spawnThread(function()
		local ok, runErr = pcall(chunk)
		if not ok then
			print("[Server Joiner] the session ended: " .. tostring(runErr))
		end
	end)
	return true
end

