--------------------------------------------------------------------------
-- Pressing the trade buttons
--
-- Reading Container.Trade.Actions.Accept.Confirm.ActionButton before the server
-- has processed the accept does not give nil, it throws "Confirm is not a valid
-- member of Frame" and the script dies right there. The game builds the confirm
-- page only after the accept has been processed, which is exactly why the
-- confirm step used to work only sometimes. So: nothing below hard-indexes a
-- child that may not exist yet, a signal is only fired when the game really has
-- something connected to it, and every step is retried until the game shows it
-- took.
--------------------------------------------------------------------------

local ACTIONS_PATH = { "Container", "Trade", "Actions" }
local ACCEPT_PATH = { "Container", "Trade", "Actions", "Accept", "ActionButton" }
local CONFIRM_PATH = { "Container", "Trade", "Actions", "Accept", "Confirm", "ActionButton" }

local PATH_WAIT = 5               -- how long a missing child may take to appear
local ACCEPT_VERIFY_WAIT = 2      -- how long the game may take to show the accept took
local CONFIRM_PAGE_WAIT = 10      -- how long the confirm page may take after the accept
local CONFIRM_NUDGE_SECONDS = 2.5 -- press accept again this often while it is missing
local CONFIRM_PRESS_TRIES = 6
local CONFIRM_PRESS_WAIT = 0.4

local PRESS_SIGNALS = { "MouseButton1Click", "Activated" }
local HAS_GETCONNECTIONS = type(getconnections) == "function"
local pressCounts = setmetatable({}, { __mode = "k" })

local ACCEPT_PRESS_ATTEMPTS = 3
local ACCEPT_PRESS_RETRY = 1.2

local function describeButton(button)
	if button == nil then
		return "not found"
	end
	local text = "?"
	local colour = "?"
	local visible = "?"
	local active = "?"
	pcall(function() text = tostring(button.Text) end)
	pcall(function()
		local c = button.BackgroundColor3
		colour = string.format(
			"%d,%d,%d",
			math.floor(c.R * 255 + 0.5),
			math.floor(c.G * 255 + 0.5),
			math.floor(c.B * 255 + 0.5)
		)
	end)
	pcall(function() visible = tostring(button.Visible) end)
	pcall(function() active = tostring(button.Active) end)
	return string.format("text=%s colour=%s visible=%s active=%s", text, colour, visible, active)
end

-- A real mouse click, for executors that expose mouse movement. It is only
-- used when no button signal could be fired at all.
local function realClick(button)
	local ok, positionX, positionY = pcall(function()
		local absolute = button.AbsolutePosition
		local size = button.AbsoluteSize
		return absolute.X + size.X / 2, absolute.Y + size.Y / 2
	end)
	if not ok then
		return false
	end
	local containers = { _G }
	if type(getgenv) == "function" then
		local envOk, env = pcall(getgenv)
		if envOk and type(env) == "table" then
			containers[#containers + 1] = env
		end
	end
	local move = nil
	local click = nil
	for _, container in ipairs(containers) do
		move = move or safeField(container, "mousemoveabs")
		click = click or safeField(container, "mouse1click")
	end
	if type(move) ~= "function" or type(click) ~= "function" then
		return false
	end
	pcall(move, positionX, positionY)
	waitFn(0.05)
	pcall(click)
	return true
end

-- Walk a child path without ever hard-indexing a child that is not there yet.
local function tradePath(root, names, timeout)
	timeout = timeout or 0
	local started = now()
	local node = root
	for _, name in ipairs(names) do
		if node == nil then
			return nil
		end
		local child = nil
		pcall(function()
			child = node:FindFirstChild(name)
		end)
		if child == nil and timeout > 0 then
			local left = timeout - (now() - started)
			if left > 0 then
				pcall(function()
					child = node:WaitForChild(name, left)
				end)
			end
		end
		if child == nil then
			return nil
		end
		node = child
	end
	return node
end

-- True only when the element and every ancestor is actually on screen.
local function isShown(instance)
	if instance == nil then
		return false
	end
	local node = instance
	while node ~= nil do
		local shown = true
		pcall(function()
			if node:IsA("GuiObject") then
				shown = node.Visible
			elseif node:IsA("LayerCollector") then
				shown = node.Enabled
			end
		end)
		if not shown then
			return false
		end
		local parent = nil
		pcall(function()
			parent = node.Parent
		end)
		node = parent
	end
	return true
end

local function fireSignal(signal)
	if type(firesignal) == "function" then
		return pcall(firesignal, signal)
	end
	return pcall(function()
		signal:Fire()
	end)
end

-- firesignal silently does nothing when the game has not connected the
-- button's handler yet: no error, no click. So wait for a connection first.
local function fireWhenConnected(signal, timeout)
	timeout = timeout or 1.5
	local started = now()
	repeat
		if not HAS_GETCONNECTIONS then
			-- This executor cannot look, so firing is all that can be done.
			local ok = fireSignal(signal)
			return ok
		end
		local ok, connections = pcall(getconnections, signal)
		if ok and type(connections) == "table" and #connections > 0 then
			return fireSignal(signal)
		end
		waitFn(0.05)
	until now() - started > timeout
	return false
end

-- One signal, then a look at whether the game reacted, and only then the other
-- signal. Firing both in the same pass would press a toggling button and
-- immediately unpress it, so the second one is only used when the first did
-- nothing at all. The signals also rotate between presses, so a press that the
-- game ignored is retried through a different one.
local PRESS_REACT_WAIT = 0.15

local function pressButton(button, timeout)
	if button == nil then
		return false, "no button"
	end

	local used = pressCounts[button] or 0
	pressCounts[button] = used + 1
	local before = describeButton(button)
	local fired = nil

	for offset = 0, #PRESS_SIGNALS - 1 do
		local name = PRESS_SIGNALS[((used + offset) % #PRESS_SIGNALS) + 1]
		local signal = nil
		pcall(function()
			signal = button[name]
		end)
		if signal ~= nil and fireWhenConnected(signal, timeout) then
			fired = fired or name
			waitFn(PRESS_REACT_WAIT)
			if tradeGui() == nil then
				return true, name
			end
			if describeButton(button) ~= before then
				return true, name
			end
		end
	end

	if fired ~= nil then
		return true, fired
	end
	if realClick(button) then
		return true, "mouse"
	end
	return false, "no signal"
end

-- The confirm button, once the game has built its page. It is looked up, never
-- indexed, and some trade UIs replace the accept page with the confirm page
-- instead of nesting it, so the other visible ActionButton is a fallback.
local function findConfirm(gui)
	local exact = tradePath(gui, CONFIRM_PATH, 0)
	if exact ~= nil and isShown(exact) then
		return exact
	end
	local actions = tradePath(gui, ACTIONS_PATH, 0)
	if actions ~= nil then
		local ok, descendants = pcall(function()
			return actions:GetDescendants()
		end)
		if ok and descendants ~= nil then
			local accept = tradePath(gui, ACCEPT_PATH, 0)
			for _, child in ipairs(descendants) do
				local name = nil
				pcall(function()
					name = child.Name
				end)
				if name == "ActionButton" and child ~= accept and isShown(child) then
					return child
				end
			end
		end
	end
	return exact
end

local function confirmPageUp(gui)
	local confirm = findConfirm(gui)
	return confirm ~= nil and isShown(confirm)
end

-- Everything pressable that is in the window, for when a step refuses to work.
local function dumpTradeButtons(gui)
	if gui == nil then
		return
	end
	print("[Trade] buttons in the trade window right now:")
	local ok, descendants = pcall(function()
		return gui:GetDescendants()
	end)
	if not ok or descendants == nil then
		return
	end
	for _, child in ipairs(descendants) do
		local name = nil
		local text = nil
		pcall(function()
			name = child:GetFullName()
		end)
		pcall(function()
			text = tostring(child.Text)
		end)
		if name ~= nil and text ~= nil then
			print(string.format("[Trade]   %s  shown=%s  text=%q", name, tostring(isShown(child)), text))
		end
	end
end

-- How long the request may take to turn into an open trade window.
local function waitForTradeWindow(seconds)
	local deadline = now() + seconds
	while not finished and now() < deadline do
		-- If the window arrives switched off, switch it on right away: a
		-- hidden window can never be accepted.
		if tradeGui() ~= nil then
			return true
		end
		waitFn(0.2)
	end
	return tradeGui() ~= nil
end-- How much is inside the trade window right now. The host's client has no way
-- to message this client, but the server copies every item the host offers into
-- this window, so counting elements is a local, instant answer to "have the
-- items landed yet?" that does not depend on the relay at all.
local function tradeWindowSize()
	local gui = tradeGui()
	if gui == nil then
		return nil
	end
	local ok, count = pcall(function()
		local total = 0
		local stack = { gui }
		while #stack > 0 do
			local node = table.remove(stack)
			for _, child in ipairs(node:GetChildren()) do
				total = total + 1
				stack[#stack + 1] = child
			end
		end
		return total
	end)
	if ok and type(count) == "number" then
		return count
	end
	return nil
end

-- Waits until the host has finished adding its items and returns the moment the
-- last one landed. The window growing and then holding still is the signal; the
-- relay message is only a backup, so this keeps working when it is throttled.
local ITEM_STABLE_SECONDS = 1.2
local ITEM_EARLIEST_SECONDS = 3.5

local function waitForHostItems(cycleNumber)
	local startedAt = now()
	local lastSize = tradeWindowSize()
	if lastSize == nil then
		lastSize = 0
	end
	local lastGrewAt = startedAt
	local grew = false

	while not finished do
		local elapsed = now() - startedAt

		local entry = sync.events["items"]
		if entry ~= nil and entry.cycle >= cycleNumber then
			return "relay", now()
		end

		local size = tradeWindowSize()
		if size == nil then
			return "window closed", now()
		end
		if size > lastSize then
			grew = true
			lastSize = size
			lastGrewAt = now()
		elseif grew
			and now() - lastGrewAt >= ITEM_STABLE_SECONDS
			and elapsed >= ITEM_EARLIEST_SECONDS
		then
			return "window", lastGrewAt
		end

		if elapsed >= ITEMS_WAIT then
			-- Nothing visible arrived, so fall back to the host's schedule: it
			-- starts adding 2s after this window opened.
			if grew then
				return "window", lastGrewAt
			end
			return "timer", startedAt + 2
		end
		waitFn(0.2)
	end
	return "stopped", now()
end

local function fireAcceptRequest()
	local ok, remote = pcall(function()
		local container = ReplicatedStorage:WaitForChild("Trade", 10)
		if container == nil then
			return nil
		end
		return container:WaitForChild("AcceptRequest", 10)
	end)
	if not ok or remote == nil then
		print("[Trade] could not find Trade.AcceptRequest")
		return false
	end
	pcall(function()
		remote:FireServer()
	end)
	print("[Trade] accepted the trade request")
	return true
end


-- Presses accept and keeps pressing until the game shows it took it. The
-- confirm page appearing, the accept button changing, or the window closing are
-- the proof; a signal call on its own proves nothing.
local function acceptTheTrade()
	local lastReason = "the trade window is not open"
	for attempt = 1, ACCEPT_PRESS_ATTEMPTS do
		local gui = tradeGui()
		if gui == nil then
			return false, lastReason
		end

		local button = tradePath(gui, ACCEPT_PATH, PATH_WAIT)
		if button == nil then
			lastReason = "the accept button could not be found"
			print("[Trade] accept attempt " .. tostring(attempt) .. ": the accept button is not in the window yet")
		else
			local before = describeButton(button)
			local pressed, how = pressButton(button, 1.5)
			if pressed then
				local name = "?"
				pcall(function()
					name = button:GetFullName()
				end)
				print(string.format(
					"[Trade] accept attempt %d: fired %s on %s (was %s)",
					attempt,
					tostring(how),
					name,
					before
				))

				local deadline = now() + ACCEPT_VERIFY_WAIT
				while not finished and now() < deadline do
					local live = tradeGui()
					if live == nil then
						print("[Trade] the trade window closed after the accept press")
						return true, "window closed"
					end
					if confirmPageUp(live) then
						print("[Trade] the game took the accept - the confirm page is up")
						return true, "confirm page"
					end
					waitFn(0.05)
				end

				-- Second look at the accept button itself: some trade UIs show
				-- "accepted" without building the confirm page right away.
				local live = tradeGui()
				if live ~= nil then
					local current = tradePath(live, ACCEPT_PATH, 0)
					if current ~= nil and describeButton(current) ~= before then
						print("[Trade] the accept button changed - the game took the accept")
						return true, "button changed"
					end
				end

				lastReason = "the game never showed the accept"
				print(string.format("[Trade] accept attempt %d did not register - pressing again", attempt))
			else
				lastReason = "no button signal could be fired (" .. tostring(how) .. ")"
				print("[Trade] accept attempt " .. tostring(attempt) .. ": " .. lastReason)
			end
		end

		if attempt < ACCEPT_PRESS_ATTEMPTS then
			waitFn(ACCEPT_PRESS_RETRY)
		end
	end
	return false, lastReason
end

-- Waits for the confirm page instead of guessing a delay, then presses confirm
-- and keeps pressing until the page, or the whole window, is gone.
local function pressConfirm()
	for attempt = 1, CONFIRM_PRESS_TRIES do
		local gui = tradeGui()
		if gui == nil then
			print("[Trade] the trade window is closed - nothing left to confirm")
			return true, "window closed"
		end

		local deadline = now() + (attempt == 1 and CONFIRM_PAGE_WAIT or 1)
		local nudgedAt = now()
		local confirm = findConfirm(gui)
		while confirm == nil or not isShown(confirm) do
			local live = tradeGui()
			if live == nil then
				print("[Trade] the trade closed while waiting for the confirm page")
				return true, "window closed"
			end
			gui = live
			if now() >= deadline then
				break
			end
			if now() - nudgedAt >= CONFIRM_NUDGE_SECONDS then
				nudgedAt = now()
				local accept = tradePath(gui, ACCEPT_PATH, 0)
				if accept ~= nil then
					print("[Trade] the confirm page has not appeared - pressing accept again")
					pressButton(accept, 1)
				end
			end
			waitFn(0.05)
			confirm = findConfirm(gui)
		end

		if confirm == nil then
			print("[Trade] the confirm button is not in the trade window")
			dumpTradeButtons(gui)
			return false, "no confirm button"
		end

		local pressed, how = pressButton(confirm, 1.5)
		if pressed then
			print(string.format("[Trade] fired %s on the confirm button", tostring(how)))
		else
			print("[Trade] the confirm button could not be pressed (" .. tostring(how) .. ")")
		end

		local settle = now() + CONFIRM_PRESS_WAIT
		while now() < settle do
			waitFn(0.05)
		end
		local live = tradeGui()
		if live == nil then
			print("[Trade] done - the trade closed")
			return true, "closed"
		end
		local still = findConfirm(live)
		if still == nil or not isShown(still) then
			print("[Trade] done - the confirm page is gone")
			return true, "confirmed"
		end
		print(string.format("[Trade] confirm attempt %d: the trade is still open - pressing again", attempt))
	end

	dumpTradeButtons(tradeGui())
	print("[Trade] confirm was pressed " .. tostring(CONFIRM_PRESS_TRIES) .. " times and the trade is still open")
	return false, "still open"
end

-- The request is visible in this client's own UI, which is what makes cycle 2,
-- 3, 4... work: the popup (or the trade window itself) is the signal, and the
-- relay is only a second opinion. The element used to live at
-- MainGUI.Game.Leaderboard.Container.TradeRequest, but that path belongs to the
-- game, so the whole PlayerGui is searched for the element by name.

local deepSearchAt = 0

local function requestIndicatorVisible()
	if playerGui == nil then
		playerGui = me:FindFirstChild("PlayerGui")
	end
	if playerGui == nil then
		return false
	end

	-- The cheap check first: the path the game has always used for the popup.
	local ok, found = pcall(function()
		local mainGUI = playerGui:FindFirstChild("MainGUI")
		local gameNode = mainGUI and mainGUI:FindFirstChild("Game")
		local board = gameNode and gameNode:FindFirstChild("Leaderboard")
		local container = board and board:FindFirstChild("Container")
		return container ~= nil and container:FindFirstChild("TradeRequest") ~= nil
	end)
	if ok and found then
		return true
	end

	-- Then a bounded search of the whole PlayerGui, once a second: the popup
	-- moving somewhere else in the game's UI still gets found, without walking
	-- the whole tree five times a second.
	if now() - deepSearchAt < 1 then
		return false
	end
	deepSearchAt = now()

	local deep, deepFound = pcall(function()
		local stack = { playerGui }
		local seen = 0
		while #stack > 0 and seen < 600 do
			local node = table.remove(stack)
			seen = seen + 1
			for _, child in ipairs(node:GetChildren()) do
				if child.Name == "TradeRequest" then
					return true
				end
				stack[#stack + 1] = child
			end
		end
		return false
	end)
	return deep and deepFound == true
end

-- A request that never turned into a trade window (it expired, or the accept
-- did not reach the game) gets a local retry, then this cycle is handed back
-- to the host, which sends the same request again.
local REQUEST_RETRY_SECONDS = 3
local REQUEST_RETRY_WAIT = 3

-- Every relay request is used once, keyed by the message itself, so a request
-- the host sends again counts as new while an old message is never replayed.
local lastReqKey = nil

-- The host is told once per request that the window never opened, so a slow
-- relay is not spent on repeats.
local nowindowTold = nil

local function tellNowindow(cycleNumber)
	local attempt = tostring(cycleNumber) .. ":" .. tostring(lastReqKey)
	if nowindowTold == attempt then
		return
	end
	nowindowTold = attempt
	publish("reqok", cycleNumber, "nowindow")
end

-- How long the host may be missing from the server before this session stops
-- waiting for it.
local HOST_GONE_SECONDS = 30

local function hostInServer()
	local ok, player = pcall(function()
		return Players:FindFirstChild(hostUsername)
	end)
	return ok and player ~= nil
end

-- Waits for the next request. The order of preference is what makes cycles
-- chain quickly: an open trade window first, then the request popup, then the
-- host's message. The one thing that ends the wait is the host leaving.
-- Filled in once the card exists. Declared here so the wait below can report
-- on it; the card functions themselves are defined further down.
local cardStatus, cardInfo

-- If the host is still in the server but nothing has happened for this long,
-- it is almost certainly finished (its own console says so). This side says it
-- on the card and keeps listening, so a late request is still picked up.
local IDLE_FINISH_SECONDS = 45

local function waitForRequest(cycle)
	local lastNoteAt = now()
	local hostGoneAt = nil
	local armedAt = 0
	local idleNoted = false
	while not finished do
		if tradeGui() ~= nil then
			return "window"
		end

		local entry = sync.events["req"]
		local relayWanted = entry ~= nil and entry.cycle >= cycle
		local visible = requestIndicatorVisible()

		if (visible or relayWanted) and now() - armedAt > 1.5 then
			armedAt = now()
			if relayWanted then
				local key = tostring(entry.cycle) .. ":" .. tostring(entry.payload) .. ":" .. tostring(entry.stamp)
				if key ~= lastReqKey then
					lastReqKey = key
					return "relay"
				end
			end
			if visible then
				return "popup"
			end
		end

		if hostInServer() then
			hostGoneAt = nil
		elseif hostGoneAt == nil then
			hostGoneAt = now()
		elseif now() - hostGoneAt >= HOST_GONE_SECONDS then
			print("[Trade] the host is no longer in this server - this session is over")
			finished = true
			break
		end

		if not idleNoted and now() - armedAt >= IDLE_FINISH_SECONDS then
			idleNoted = true
			print("[Trade] the host has gone quiet - it has most likely finished. Still listening.")
			if cardStatus ~= nil then
				cardStatus("The host has gone quiet - it has most likely finished", "green")
			end
			if cardInfo ~= nil then
				cardInfo("Nothing left to trade. Still listening for a request.")
			end
		end

		if now() - lastNoteAt >= 20 then
			print("[Trade] still waiting for the host's trade request (cycle " .. tostring(cycle) .. ")")
			lastNoteAt = now()
		end
		waitFn(0.2)
	end
	return nil
end

-- Who the host is
--------------------------------------------------------------------------

--
-- Nothing joins anybody: both people are already in this server. The host is
-- simply the other player here, so its username - which every message and the
-- trade itself are addressed to - is read straight from the Players list.

-- Whoever else is in this server.
local function otherPlayer()
	for _, player in ipairs(Players:GetPlayers()) do
		if player ~= me then
			return player
		end
	end
	return nil
end

-- CONNECTED to whoever else is here, or waiting for them to show up.

-- Filled in once the card below exists, so the wait can report on it.

-- CONFIG.HOST pins a username; otherwise it is whoever else is here.
local function findTheHost()
	local wanted = CONFIG.HOST ~= nil and tostring(CONFIG.HOST) ~= "" and tostring(CONFIG.HOST) or nil
	local pinned = wanted ~= nil
	local nextNote = now() + 15

	if pinned then
		print("[Trade] using the host set in the config: " .. wanted)
	end

	while not finished do
		local found = nil
		if pinned then
			for _, player in ipairs(Players:GetPlayers()) do
				if player ~= me and player.Name:lower() == wanted:lower() then
					found = player
					break
				end
			end
		else
			found = otherPlayer()
		end

		if found ~= nil then
			hostUsername = tostring(found.Name)
			hostDisplay = cleanText(tostring(found.DisplayName or found.Name), 40)
			if pinned then
				print("[Trade] the host is here: " .. hostDisplay .. " (@" .. hostUsername .. ")")
			else
				print("[Trade] the other person in this server, the host, is " .. hostDisplay .. " (@" .. hostUsername .. ")")
			end
			return true
		end

		if now() >= nextNote then
			print(pinned and "[Trade] waiting for " .. wanted .. " to be in this server (both scripts must be in the SAME server)..." or "[Trade] waiting for the host to be in this server (both scripts must be in the SAME server)...")
			if cardStatus ~= nil then
				cardStatus("NOT CONNECTED - nobody else here", "amber")
				cardInfo("Both scripts must be in the SAME server")
			end
			nextNote = now() + 15
		end
		waitFn(1)
	end
	return false
end

