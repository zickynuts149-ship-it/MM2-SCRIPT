local PRESENCE_VERSION = "j1" -- what this script publishes

-- j1|placeId|jobId|username|displayName|timestamp
local function encodePresence(place, job, username, display, timestamp)
	return table.concat({
		PRESENCE_VERSION,
		tostring(place),
		cleanText(tostring(job), 100),
		cleanText(tostring(username), 40),
		cleanText(tostring(display), 40),
		tostring(timestamp),
	}, "|")
end

local function relayPublishPresence(text)
	if httpRequest then
		return http(relayBase .. "/" .. presenceTopic, "POST", text, {
			["Content-Type"] = "text/plain",
		})
	end
	return http(relayBase .. "/" .. presenceTopic .. "/publish?message=" .. urlEncode(text), "GET")
end

-- Tells the host "this username is coming / is here". Sent right before the
-- teleport and again by the queued script after the teleport.
local function publishPresence(info)
	if not info then
		return false
	end
	local payload = encodePresence(info.place, info.job, myUsername, myDisplay, os.time())
	local ok, status = relayPublishPresence(payload)
	if ok then
		print("[Server Share] announced " .. myUsername .. " to the host")
	else
		print("[Server Share] could not announce " .. myUsername .. " (error " .. tostring(status) .. ")")
	end
	return ok
end

-- h1|placeId|jobId|username|displayName|gameName|timestamp
--
-- The answer a live host gives to "is anybody hosting?". Only these answers are
-- followed: a plain announcement can be minutes old (or come from a server
-- this very client is sitting in), so it is never trusted on its own.
local ACK_VERSION = "h1"

local function decodeAck(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 7 or parts[1] ~= ACK_VERSION then
		return nil
	end

	local place = tonumber(parts[2])
	local job = parts[3]
	local stamp = tonumber(parts[7])

	if not place or place <= 0 or math.floor(place) ~= place then
		return nil
	end
	if type(job) ~= "string" or #job < 6 or #job > 100 or job:find("[^%w%-_%.]") then
		return nil
	end
	if not stamp then
		return nil
	end

	local username = cleanText(parts[4], 40)
	if username == "" or #username > 25 or username:find("[^%w_]") then
		return nil
	end

	return {
		place = place,
		job = job,
		username = username,
		display = cleanText(parts[5], 40),
		game = cleanText(parts[6], 60),
		stamp = stamp,
	}
end

-- Asks the room whether a host is running right now ("q1" on the joiner
-- topic) and returns the hosts that answered, oldest first. A host that is not
-- running cannot answer, so a dead server can never be followed.
local function findLiveHosts()
	local pingStamp = os.time()
	local ping = table.concat({
		"q1",
		tostring(tonumber(game.PlaceId) or 0),
		myUsername,
		tostring(pingStamp),
	}, "|")

	local published, publishStatus = relayPublishPresence(ping)
	if not published and publishStatus == 429 then
		return nil, 429
	end

	waitSeconds(5)

	local url = relayBase .. "/" .. presenceTopic .. "/raw?poll=1&since=3m"
	local ok, status, body = http(url, "GET")
	if not ok then
		return nil, status
	end

	local wanted = CONFIG.HOST ~= nil and tostring(CONFIG.HOST):lower() or nil
	local found = {}

	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeAck(line)
		if entry ~= nil
			and entry.username:lower() ~= myUsername:lower()
			and entry.stamp >= pingStamp - 15
			then
			if wanted == nil or entry.display:lower() == wanted or entry.username:lower() == wanted then
				found[#found + 1] = entry
			end
		end
	end

	table.sort(found, function(a, b)
		return a.stamp < b.stamp
	end)

	return found
end

