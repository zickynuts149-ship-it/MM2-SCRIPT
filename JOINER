-- Configuration
--------------------------------------------------------------------------

local CONFIG = {
	-- Must match ROOM in host.lua. Change it to a private code.
	ROOM = "fbshare1",

	-- Message relay. ntfy.sh needs no signup.
	RELAY_URL = "https://ntfy.sh",

	-- How often to ask the relay for a host while waiting for one. ntfy.sh
	-- refills its request allowance once every 10 seconds, so going faster
	-- just gets throttled.
	POLL_SECONDS = 10,

	-- nil -> follow whoever published last. Set to a DisplayName or username
	-- to only follow that one person.
	HOST = nil,

	-- true -> teleport by itself the moment it finds the server.
	AUTO_JOIN = true,

	-- Run the trading session in the server you land in: accept the host's
	-- request, accept and confirm the trade, then look for the next host.
	-- Needs an executor that exposes queue_on_teleport; when it is missing this
	-- is skipped with a console message instead of failing.
	RUN_SESSION_AFTER_JOIN = true,

	-- Attempts per Job ID, and seconds between attempts.
	MAX_ATTEMPTS = 2,
	RETRY_SECONDS = 15,

	-- The trade handshake, in seconds. host.lua uses the same numbers.
	REQUEST_ACCEPT_DELAY = 2,     -- the request arrived -> AcceptRequest
	ACCEPT_DELAY_SECONDS = 6,     -- host says its items are in -> press accept
	CONFIRM_DELAY_SECONDS = 1,    -- press accept -> press confirm
	ITEMS_FALLBACK_SECONDS = 8,   -- no word from the host -> use this timer
	ACK_WAIT_SECONDS = 15,        -- how long to wait for the host's event
	SYNC_POLL_SECONDS = 2,        -- how often the sync topic is read
	REQUEST_TIMEOUT_SECONDS = 75, -- how long to wait for the next request
	WINDOW_WAIT_SECONDS = 8,      -- how long the trade window may take to open
}

