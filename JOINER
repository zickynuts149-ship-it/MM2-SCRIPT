--------------------------------------------------------------------------
-- The sync topic
--------------------------------------------------------------------------

local sync = { events = {} }
local finished = false

local function publish(event, cycle, payload)
	local body = table.concat({
		"s1",
		cleanText(tostring(event), 16),
		tostring(myPlace),
		cleanText(myJob, 100),
		tostring(tonumber(cycle) or 0),
		cleanText(tostring(payload or ""), 60),
		cleanText(hostUsername, 40),
		cleanText(myUsername, 40),
		tostring(os.time()),
	}, "|")
	local ok, status = httpSend(relayBase .. "/" .. syncTopic, "POST", body)
	if not ok then
		print("[Server Share] could not send '" .. tostring(event) .. "' (error " .. tostring(status) .. ")")
	end
	return ok
end

local function decodeSync(text)
	if type(text) ~= "string" then
		return nil
	end
	local parts = {}
	for part in (text .. "|"):gmatch("([^|]*)|") do
		parts[#parts + 1] = part
	end
	if #parts ~= 9 or parts[1] ~= "s1" then
		return nil
	end
	local place = tonumber(parts[3])
	local cycle = tonumber(parts[5])
	local stamp = tonumber(parts[9])
	if not place or place <= 0 or not cycle or not stamp then
		return nil
	end
	return {
		event = cleanText(parts[2], 16),
		place = place,
		job = parts[4],
		cycle = cycle,
		payload = cleanText(parts[6], 60),
		host = cleanText(parts[7], 40),
		joiner = cleanText(parts[8], 40),
		stamp = stamp,
	}
end

local function pollSync()
	local ok, status, body = httpSend(relayBase .. "/" .. syncTopic .. "/raw?poll=1&since=10m", "GET")
	if not ok then
		if status == 429 then
			waitFn(5)
		end
		return
	end

	local wantedHost = hostUsername:lower()
	local wantedMe = myUsername:lower()

	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeSync(line)
		if entry
			and entry.place == myPlace
			and entry.job == myJob
			and entry.host:lower() == wantedHost
			and entry.joiner:lower() == wantedMe
		then
			if entry.event == "done" then
				finished = true
			end
			local current = sync.events[entry.event]
			if current == nil or entry.cycle >= current.cycle then
				sync.events[entry.event] = entry
			end
		end
	end
end

spawnFn(function()
	while not finished do
		pollSync()
		waitFn(SYNC_POLL)
	end
end)

local function waitFor(event, cycle, timeoutSeconds)
	local deadline = now() + timeoutSeconds
	while not finished do
		local entry = sync.events[event]
		if entry ~= nil and entry.cycle >= cycle then
			return true
		end
		if now() >= deadline then
			return false
		end
		waitFn(0.25)
	end
	return false
end

