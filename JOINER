local function decode(hex)
	return (hex:gsub("%x%x", function(byte)
		return string.char(tonumber(byte, 16))
	end))
end

local function sanitizeRoom(raw)
	local cleaned = tostring(raw or ""):lower():gsub("[^%w_%-]", "")
	if #cleaned > 48 then
		cleaned = cleaned:sub(1, 48)
	end
	if cleaned == "" then
		cleaned = "main"
	end
	return cleaned
end

