	if tonumber(game.PlaceId) == info.place and currentJobId() == info.job then
		-- Already inside: tell the host once, so a host script started later
		-- knows who is here, and start the session here instead of teleporting
		-- to the server we are already sitting in.
		if state.announcedJob ~= info.job then
			state.announcedJob = info.job
			hostUsername = info.username
			hostDisplay = info.display
			publishPresence(info)
			if CONFIG.RUN_SESSION_AFTER_JOIN and startSessionHere() then
				setStatus("You are already in " .. info.username .. "'s server. Session started.", THEME.green)
			else
				setStatus("You are already in " .. info.username .. "'s server. Announced yourself to the host.", THEME.green)
			end
		else
			setStatus("You are already in " .. info.username .. "'s server.", THEME.green)
		end
		return
	end

	local attempts = state.attempts[info.job] or 0
	if attempts >= CONFIG.MAX_ATTEMPTS then
		setStatus("Gave up on this server after " .. attempts .. " attempts. Press Join now to retry.", THEME.red)
		return
	end
	if os.time() - state.lastAttemptAt < CONFIG.RETRY_SECONDS then
		return
	end

	state.attempts[info.job] = attempts + 1
	state.lastAttemptAt = os.time()
	state.lastJob = info.job
	state.pending = true

	setStatus("Joining " .. info.game .. " on " .. info.display .. "'s server...", THEME.amber)

	hostUsername = info.username
	hostDisplay = info.display

	-- Tell the host who is coming before the teleport happens. This is what
	-- lets host.lua watch the Players list for the right username.
	publishPresence(info)

	-- Queue before the teleport: this environment is thrown away, the queued
	-- source is what runs in the server we land in.
	if CONFIG.RUN_SESSION_AFTER_JOIN then
		if not queueSession() then
			print("[Server Joiner] could not queue the session script; the host will not be answered")
		end
	end

	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(info.place, info.job, Players.LocalPlayer)
	end)

	if not ok then
		clearQueuedScript()
		offerFallback(info)
		return
	end

	-- The teleport is asynchronous: if nothing changes in 14 seconds, the
	-- request did not go through, so say so instead of sitting on "Joining...".
	spawnThread(function()
		waitSeconds(14)
		if not state.running or not state.pending then
			return
		end
		if state.lastJob ~= info.job then
			return
		end
		if tonumber(game.PlaceId) == info.place and currentJobId() == info.job then
			return
		end
		if tonumber(game.PlaceId) == info.place then
			state.pending = false
			clearQueuedScript()
			setStatus("Teleport did not start. The server may be full, restricted or gone.", THEME.red)
		end
	end)
end

ui.join.MouseButton1Click:Connect(function()
	if not state.info then
		setStatus("No server info yet - waiting for the host to run host.lua.", THEME.amber)
		return
	end
	state.attempts[state.info.job] = 0
	state.lastAttemptAt = 0
	state.pending = false
	attemptJoin(state.info)
end)

ui.stop.MouseButton1Click:Connect(function()
	state.running = false
	ui.gui:Destroy()
	print("[Server Joiner] stopped listening room '" .. room .. "'")
end)

