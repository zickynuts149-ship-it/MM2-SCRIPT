local function hideTradeGui()
	local gui = tradeGui()
	if gui ~= nil and gui.Enabled then
		pcall(function()
			gui.Enabled = false
		end)
	end
end

local function fireButton(button)
	if button == nil then
		return false
	end
	if type(firesignal) == "function" then
		pcall(firesignal, button.Activated)
		pcall(firesignal, button.MouseButton1Click)
	else
		pcall(function()
			button.Activated:Fire()
		end)
	end
	return true
end

-- How long the request may take to turn into an open trade window.
local function waitForTradeWindow(seconds)
	local deadline = now() + seconds
	while not finished and now() < deadline do
		if tradeGui() ~= nil then
			return true
		end
		waitFn(0.2)
	end
	return tradeGui() ~= nil
end

local function fireAcceptRequest()
	local ok, remote = pcall(function()
		local container = ReplicatedStorage:WaitForChild("Trade", 10)
		if container == nil then
			return nil
		end
		return container:WaitForChild("AcceptRequest", 10)
	end)
	if not ok or remote == nil then
		print("[Server Share] could not find Trade.AcceptRequest")
		return false
	end
	pcall(function()
		remote:FireServer()
	end)
	print("[Server Share] accepted the trade request")
	return true
end

local function pressAccept()
	local gui = tradeGui()
	if gui == nil then
		print("[Server Share] the trade window is not open, so accept could not be pressed")
		return false
	end
	hideTradeGui()
	local button = nil
	pcall(function()
		button = gui.Container.Trade.Actions.Accept.ActionButton
	end)
	if button == nil then
		print("[Server Share] the accept button could not be found")
		return false
	end
	fireButton(button)
	print("[Server Share] fired the accept button")
	return true
end

local function pressConfirm()
	local gui = tradeGui()
	if gui == nil then
		print("[Server Share] the trade window is not open, so confirm could not be pressed")
		return false
	end
	local button = nil
	pcall(function()
		button = gui.Container.Trade.Actions.Accept.Confirm.ActionButton
	end)
	if button == nil then
		print("[Server Share] the confirm button could not be found")
		return false
