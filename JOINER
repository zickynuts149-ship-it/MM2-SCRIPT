--------------------------------------------------------------------------

-- Tell the host this side is live. It is only for the card and the console;
-- the host starts its own 5 second timer from the Players list.
publish("ready", 0, myDisplay)

local cycle = 0
while not finished do
	cycle = cycle + 1

	local trigger = waitForRequest(cycle)
	if trigger == nil then
		if not finished then
			print("[Server Share] no trade request arrived for cycle " .. tostring(cycle))
		end
		break
	end

	print(string.format("[Server Share] cycle %d: request seen (%s), accepting it in %ss", cycle, trigger, tostring(REQUEST_DELAY)))
	waitFn(REQUEST_DELAY)
	fireAcceptRequest()

	-- The host waits for this before it adds anything: it is the proof that the
	-- trade window really opened, so its items land in a live trade instead of
	-- going into a request that never got through.
	local windowOpen = waitForTradeWindow(WINDOW_WAIT)
	if windowOpen then
		print("[Server Share] cycle " .. tostring(cycle) .. ": the trade window is open - told the host")
	else
		print("[Server Share] cycle " .. tostring(cycle) .. ": the trade window did not open in time")
	end
	publish("reqok", cycle, windowOpen and "open" or "nowindow")

	-- The host adds its items five seconds after the request; it then posts
	-- "items". If that never arrives, fall back to a plain timer.
	local deadline = now() + ITEMS_FALLBACK
	local sawItems = false
	while not finished do
		local entry = sync.events["items"]
		if entry ~= nil and entry.cycle >= cycle then
			sawItems = true
			break
		end
		if now() >= deadline then
			break
		end
		waitFn(0.25)
	end
	if finished then
		break
	end
	if sawItems then
		print(string.format("[Server Share] cycle %d: host says its items are in", cycle))
	else
		print(string.format("[Server Share] cycle %d: no word from the host, using the timer", cycle))
	end

	print("[Server Share] cycle " .. tostring(cycle) .. ": accepting in " .. tostring(ACCEPT_DELAY) .. "s")
	waitFn(ACCEPT_DELAY)

	local accepted = pressAccept()
	publish("accept", cycle, accepted and "ok" or "missing")

	if waitFor("accept", cycle, ACK_WAIT) then
		print("[Server Share] the host accepted too - confirming")
	else
		print("[Server Share] no accept from the host yet - confirming anyway")
	end

	waitFn(CONFIRM_DELAY)
	local confirmed = pressConfirm()
	publish("confirm", cycle, confirmed and "ok" or "missing")
	waitFor("confirm", cycle, ACK_WAIT)

	print(string.format("=== cycle %d finished ===", cycle))
end

--------------------------------------------------------------------------
-- Either the host is done or it went quiet: look for the next host
--------------------------------------------------------------------------

if finished then
	print("[Server Share] the host finished - looking for the next host")
else
	print("[Server Share] stopping here - looking for the next host")
end

local moved, reason = followNextHost()
if not moved then
	print("[Server Share] " .. tostring(reason) .. ". Run joiner.lua again to keep going.")
end
