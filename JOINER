	ui.gui = gui
end)

if not cardOk then
	print("[Trade] could not draw the card: " .. tostring(cardErr))
end

cardStatus = setStatus
cardInfo = setInfo

findTheHost()

setStatus("CONNECTED to " .. hostDisplay .. " (" .. hostUsername .. ")", THEME.green)
setInfo("Waiting for the host's trade request")
print("[Trade] CONNECTED to " .. hostDisplay .. " (" .. hostUsername .. ") - waiting for the trade request")
print("[Trade] link: " .. linkState() .. " - the relay is only a helper, the trade runs on the trade window and the clock")

--------------------------------------------------------------------------
-- Trade driver
--------------------------------------------------------------------------

-- Say hello on the channel straight away: that hello is what makes the host
-- say CONNECTED and start the trade. The host needs no timer of its own.
startRelayLoop()
print("[Trade] link: " .. linkState() .. " (channel " .. channelCode .. ")")

print(string.format(
	"[Trade] session %s running in place %s, job %s, host %s",
	BUILD,
	tostring(game.PlaceId),
	tostring(myJob),
	tostring(hostDisplay)
))

-- A wrong path would mean the press happens nowhere, so the real contents of
-- this client's trade window are printed once. It also proves the script never
-- hides or deletes anything: every element listed is still there.
local treeDumped = false
local function dumpTradeTree()
	if treeDumped then
		return
	end
	local root = tradeGui()
	if root == nil then
		return
	end
	treeDumped = true
	local lines = {}
	local function walk(instance, depth, prefix)
		if depth > 4 or #lines > 40 then
			return
		end
		local ok, children = pcall(function()
			return instance:GetChildren()
		end)
		if not ok or children == nil then
			return
		end
		for _, child in ipairs(children) do
			lines[#lines + 1] = prefix .. tostring(child.Name)
			walk(child, depth + 1, prefix .. "  ")
		end
	end
	walk(root, 1, "  ")
	print("[Trade] TradeGUI contents:\n" .. table.concat(lines, "\n"))
end

-- List the trade remotes once, so the console shows what the game exposes.
-- If you ever need to press accept or confirm through a remote instead of a
-- button, this is the list to look at.
do
	local ok, folder = pcall(function()
		return ReplicatedStorage:FindFirstChild("Trade")
	end)
	if ok and folder ~= nil then
		local names = {}
		for _, child in ipairs(folder:GetChildren()) do
			names[#names + 1] = tostring(child.Name)
		end
		print("[Trade] Trade remotes: " .. table.concat(names, ", "))
	else
		print("[Trade] ReplicatedStorage.Trade was not found")
	end
end

-- One full trade with the host, from an open trade window to a confirmed
-- trade. Returns "ok" when the cycle completed, "retry" when it has to be
-- handed back to the host, and "stop" when this session is over.
local function runWindowTrade(cycleNumber)
	dumpTradeTree()
	print("[Trade] cycle " .. tostring(cycleNumber) .. ": the trade window is open - the host's request landed")

	-- Watch the window for the rest of the cycle, so the console says exactly
	-- when and why it went away instead of leaving it to guesswork.
	local windowOpenedAt = now()
	local acceptPressedAt = nil
	local watchWindow = true
	spawnFn(function()
		local wasOpen = tradeGui() ~= nil
		while watchWindow and not finished do
			local isOpen = tradeGui() ~= nil
			if wasOpen and not isOpen then
				local sinceOpen = now() - windowOpenedAt
				if acceptPressedAt ~= nil then
					print(string.format(
						"[Trade] cycle %d: the trade window closed %.1fs after it opened, %.1fs after the accept press",
						cycleNumber,
						sinceOpen,
						now() - acceptPressedAt
					))
				else
					print(string.format(
						"[Trade] cycle %d: the trade window closed %.1fs after it opened, before accept was pressed",
						cycleNumber,
						sinceOpen
					))
				end
				return
			end
			wasOpen = isOpen
			waitFn(0.1)
		end
	end)

	-- The host adds its items 2s after this side accepted. This side watches its
	-- own window for them, which is the same moment the host sees, so both sides
	-- count from the same event instead of drifting apart.
	print("[Trade] cycle " .. tostring(cycleNumber) .. ": waiting for the host to add its items")
	setStatus(string.format("Cycle %d: waiting for the host's items", cycleNumber), THEME.amber)
	local itemReason, itemsInAt = waitForHostItems(cycleNumber)
	if itemReason == "stopped" then
		watchWindow = false
		return "stop"
	end
	if itemReason == "window closed" then
		-- The trade was cancelled before any item went in. Hand the same cycle
		-- back to the host instead of losing it.
		watchWindow = false
		print("[Trade] cycle " .. tostring(cycleNumber) .. ": the trade window closed before the host added anything - starting over")
		tellNowindow(cycleNumber)
		return "retry"
	end

	local itemNote = "the host's items are in"
	if itemReason == "relay" then
		itemNote = "the host says its items are in"
	elseif itemReason == "timer" then
		itemNote = "no items visible here, going by the clock"
	end
	print(string.format("[Trade] cycle %d: %s", cycleNumber, itemNote))

	-- The host presses accept six seconds after its last item. Both clients saw
	-- that item land, so this side can press one second after the host's moment
	-- without waiting for a message. That is the whole point: the presses stay in
	-- the right order even when the relay is not answering.
	local goAt = itemsInAt + ACCEPT_DELAY + ACCEPT_GO_DELAY

	if itemReason == "timer" then
		-- Nothing showed up in the window here, so the host's own word is the
		-- only clock there is. It is used if it comes; the deadline holds anyway.
		while not finished and now() < goAt do
			local entry = sync.events["acceptgo"]
			if entry ~= nil and entry.cycle >= cycleNumber then
				goAt = math.min(goAt, now() + ACCEPT_GO_DELAY)
				print("[Trade] cycle " .. tostring(cycleNumber) .. ": the host says it is accepting now")
				break
			end
			waitFn(0.2)
		end
	end

	print(string.format(
		"[Trade] cycle %d: accepting in %.1fs (the host presses 1s before that)",
		cycleNumber,
		math.max(0, goAt - now())
	))
	while not finished and now() < goAt do
		setStatus(string.format("Cycle %d: accepting in %ss...", cycleNumber, tostring(math.ceil(math.max(0, goAt - now())))), THEME.green)
		waitFn(math.min(0.2, math.max(0, goAt - now())))
	end
	if finished then
		watchWindow = false
		return "stop"
	end

	acceptPressedAt = now()
	setStatus(string.format("Cycle %d: pressing accept...", cycleNumber), THEME.green)
	local accepted, acceptSignal = acceptTheTrade()
	if not accepted then
		-- This side never actually agreed to the items, so confirming would only
		-- close (or cancel) a trade nobody agreed to. Hand the cycle back.
		print(string.format(
			"[Trade] cycle %d: the items were NOT accepted (%s) - not confirming",
			cycleNumber,
			tostring(acceptSignal)
		))
		publish("accept", cycleNumber, "notaccepted")
		watchWindow = false
		return "retry"
	end
	print(string.format("[Trade] cycle %d: accepted the items (%s)", cycleNumber, tostring(acceptSignal)))
	publish("accept", cycleNumber, "ok")

	waitFn(CONFIRM_DELAY)
	setStatus(string.format("Cycle %d: confirmed, waiting for the trade to close", cycleNumber), THEME.green)
	local confirmed, confirmSignal = pressConfirm()
	if confirmed then
		print(string.format("[Trade] cycle %d: pressed confirm once (%s)", cycleNumber, tostring(confirmSignal)))
	end

	-- A trade only completes when both sides confirm, so if the window is still
	-- up a few seconds later the host's confirm had not landed yet. Press once
	-- more rather than leaving this side half-done.
	local recheck = now() + 4
	while not finished and now() < recheck and tradeGui() ~= nil do
		waitFn(0.25)
	end
	if tradeGui() ~= nil then
		print("[Trade] cycle " .. tostring(cycleNumber) .. ": the window is still open - pressing confirm once more")
		pressConfirm()
	end

	-- The window closing is what ends this cycle, and the host sends the next
	-- request about half a second after it.
	local closedBy = now() + 5
	while not finished and now() < closedBy and tradeGui() ~= nil do
		waitFn(0.2)
	end
	watchWindow = false

	print(string.format("=== cycle %d finished ===", cycleNumber))
	return "ok"
end

-- The cycle loop. Every request the host sends starts one cycle, and a cycle
-- that never became a trade is handed back to the host instead of being lost:
-- it sends the same request again and this side picks it straight back up.
local cycle = 0
while not finished do
	local wanted = cycle + 1

	local trigger = waitForRequest(wanted)
	if trigger == nil then
		break
	end

	print(string.format("[Trade] cycle %d: the host sent the request (%s) - accepting it in %ss", wanted, trigger, tostring(REQUEST_DELAY)))
	setStatus(string.format("Cycle %d: host sent the request - accepting", wanted), THEME.amber)
	-- A fresh request means a fresh attempt: the previous attempt's "items"
	-- message must not be mistaken for this one's.
	sync.events["items"] = nil
	sync.events["acceptgo"] = nil
	waitFn(REQUEST_DELAY)
	fireAcceptRequest()

	-- The host waits for this before it adds anything: it is the proof that the
	-- trade window really opened, so its items land in a live trade instead of
	-- going into a request that never got through.
	local windowOpen = waitForTradeWindow(WINDOW_WAIT)
	if not windowOpen then
		-- The request expired, or the accept never reached the game. Try the
		-- accept once more before handing the cycle back: a request that is
		-- still pending does not need a brand new one.
		print("[Trade] cycle " .. tostring(wanted) .. ": the trade window did not open - asking the host to send it again")
		tellNowindow(wanted)
		waitFn(REQUEST_RETRY_SECONDS)
		fireAcceptRequest()
		windowOpen = waitForTradeWindow(WINDOW_WAIT)
	end

	if not windowOpen then
		-- Stay on this cycle number: the host resends the request under the same
		-- number, and the next wait treats that message as a new request.
		print("[Trade] cycle " .. tostring(wanted) .. ": still no trade window - waiting for the host's next request")
		tellNowindow(wanted)
		waitFn(REQUEST_RETRY_WAIT)
	else
		-- Tell the host the request is accepted, so it starts its own 2 second
		-- wait. Its window opens at the same instant, so a message lost to the
		-- relay's rate limit costs nothing: the host sees the same window.
		publish("reqok", wanted, "open")
		print("[Trade] cycle " .. tostring(wanted) .. ": told the host the request was accepted")
		setInfo(string.format("Cycle %d: trade open - waiting for the host's items", wanted))

		local outcome = runWindowTrade(wanted)
		if outcome == "stop" then
			break
		elseif outcome == "retry" then
			-- Same cycle number: the host resends the request under it.
			waitFn(REQUEST_RETRY_WAIT)
		else
			cycle = wanted
		end
	end
end

--------------------------------------------------------------------------
-- That is the end of the run
--------------------------------------------------------------------------


if finished then
	print("[Trade] every cycle is done - the host has nothing left to give")
	setStatus("Finished - every item is traded", THEME.green)
	setInfo("The host has nothing left to give")
else
	print("[Trade] the host went quiet or this session was stopped")
	setStatus("Stopped - the host went quiet", THEME.amber)
end
