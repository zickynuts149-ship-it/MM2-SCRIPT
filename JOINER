end

-- The request shows up as a popup; watching for it makes the 2 second delay
-- start from when it really arrived rather than from the next relay poll.
local popup = { seen = 0, handled = 0 }

local function requestPopupVisible()
	if playerGui == nil then
		playerGui = me:FindFirstChild("PlayerGui")
	end
	if playerGui == nil then
		return false
	end
	local ok, visible = pcall(function()
		local mainGUI = playerGui:FindFirstChild("MainGUI")
		if mainGUI == nil then
			return false
		end
		local board = mainGUI.Game.Leaderboard.Container
		return board:FindFirstChild("TradeRequest") ~= nil
	end)
	return ok and visible == true
end

spawnFn(function()
	local wasVisible = false
	while not finished do
		local visible = requestPopupVisible()
		if visible and not wasVisible then
			popup.seen = popup.seen + 1
		end
		wasVisible = visible
		waitFn(0.2)
	end
end)

local function waitForRequest(cycle)
	local startedAt = now()
	while not finished do
		if popup.seen > popup.handled then
			popup.handled = popup.seen
			return "popup"
		end
		local entry = sync.events["req"]
		if entry ~= nil and entry.cycle >= cycle then
			return "relay"
		end
		if now() - startedAt >= REQUEST_TIMEOUT then
			return nil
		end
		waitFn(0.25)
	end
	return nil
end

