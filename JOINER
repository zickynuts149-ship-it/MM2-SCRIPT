end

local function spawnThread(fn)
	if task and task.spawn then
		return task.spawn(fn)
	end
	return spawn(fn)
end

local function safeField(container, key)
	if container == nil then
		return nil
	end
	if type(container) ~= "table" and typeof(container) ~= "Instance" and type(container) ~= "userdata" then
		return nil
	end
	local ok, value = pcall(function()
		return container[key]
	end)
	if ok then
		return value
	end
	return nil
end

local function cleanText(text, maxLength)
	if type(text) ~= "string" then
		return ""
	end
	text = text:gsub("[%c]", " ")
	text = text:gsub("|", "/")
	text = text:gsub("%s+", " ")
	text = text:gsub("^%s+", "")
	text = text:gsub("%s+$", "")
	if maxLength and #text > maxLength then
		text = text:sub(1, maxLength - 1) .. "..."
	end
	return text
end

local function toHex(text)
	return (tostring(text):gsub(".", function(char)
		return string.format("%02x", string.byte(char))
	end))
end

