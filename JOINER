			tostring(myPlace),
			myUsername,
			tostring(pingStamp),
		}, "|"))
	end)

	waitFn(5)

	local ok, status, body = httpSend(relayBase .. "/" .. presenceTopic .. "/raw?poll=1&since=3m", "GET")
	if not ok then
		return nil, "the relay could not be read (error " .. tostring(status) .. ")"
	end

	local acks = {}
	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeAck(line)
		if entry ~= nil
			and entry.username:lower() ~= myUsername:lower()
			and entry.stamp >= pingStamp - 15
			then
			acks[#acks + 1] = entry
		end
	end
	return acks
end

local function findNextHost()
	local acks, err = askForHosts()
	if acks == nil then
		return nil, err
	end
	local best = nil
	for _, entry in ipairs(acks) do
		if not finishedJobs[entry.job] and entry.job ~= myJob then
			if best == nil or entry.stamp >= best.stamp then
				best = entry
			end
		end
	end
	if best == nil then
		return nil, "no other host is answering right now"
	end
	return best
end

-- The host name baked into this copy belongs to the server it was queued
-- for. A copy that followed a different host has to find out who runs this
-- job before it can talk to them.
local function findHostInThisJob()
	local ok, status, body = httpSend(relayBase .. "/" .. serverTopic .. "/raw?poll=1&since=30m", "GET")
	if not ok then
		return nil, status
	end
	local found = nil
	for line in tostring(body):gmatch("[^\r\n]+") do
		local entry = decodeServer(line)
		if entry ~= nil and entry.job == myJob then
			if found == nil or entry.stamp >= found.stamp then
				found = entry
			end
		end
	end
	if found ~= nil then
		return found
	end

	-- Nothing announced for this job: ask the live hosts straight out.
	local acks = askForHosts()
	if acks ~= nil then
		for _, entry in ipairs(acks) do
			if entry.job == myJob then
				return entry
			end
		end
	end
	return nil
end

if myJob ~= bakedJob then
	local entry = findHostInThisJob()
	if entry ~= nil then
		hostUsername = entry.username
		hostDisplay = entry.display ~= "" and entry.display or entry.username
	end
	print("[Server Share] host of this server is " .. hostDisplay .. " (" .. hostUsername .. ")")
end

local function followNextHost()
	local nextHost, reason = findNextHost()
	if nextHost == nil then
		return false, reason
	end
	if nextGeneration == "" then
		return false, "this copy has no next-generation script"
	end
	if queueOnTeleport == nil then
		return false, "this executor has no queue_on_teleport"
	end

	print(string.format(
		"[Server Share] following %s into place %d, job %s",
		nextHost.display ~= "" and nextHost.display or nextHost.username,
		nextHost.place,
		nextHost.job
	))

	-- Tell that host who is coming, then arm the next server before leaving.
	local payload = table.concat({
		"j1",
		tostring(nextHost.place),
		tostring(nextHost.job),
		myUsername,
		myDisplay,
		tostring(os.time()),
	}, "|")
	pcall(function()
		httpSend(relayBase .. "/" .. presenceTopic, "POST", payload)
	end)

	local queued = pcall(queueOnTeleport, nextGeneration)
	if not queued then
		return false, "the next server could not be armed"
	end

	local ok, err = pcall(function()
		TeleportService:TeleportToPlaceInstance(nextHost.place, nextHost.job, me)
	end)
	if not ok then
		return false, "the teleport failed: " .. tostring(err)
	end
	return true
end

