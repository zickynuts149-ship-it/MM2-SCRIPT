--------------------------------------------------------------------------
-- Running code after the teleport
--------------------------------------------------------------------------

-- queue_on_teleport is added by the executor, not by Roblox. It stores a
-- string of Lua source and runs it in the next server this client joins.
-- The game's Lua environment is destroyed by a teleport, so this queue is the
-- only way to get a script running on the other side.
local function findQueueOnTeleport()
	local containers = { _G }
	if type(getgenv) == "function" then
		local ok, environment = pcall(getgenv)
		if ok and type(environment) == "table" and environment ~= _G then
			containers[#containers + 1] = environment
		end
	end
	for _, globalName in ipairs({ "syn", "fluxus", "krnl", "http" }) do
		local container = rawget(_G, globalName)
		if container ~= nil and container ~= _G then
			containers[#containers + 1] = container
		end
	end
	for _, name in ipairs({ "queue_on_teleport", "queueonteleport", "queue_teleport" }) do
		for _, container in ipairs(containers) do
			local fn = safeField(container, name)
			if type(fn) == "function" then
				return fn, name
			end
		end
	end
	return nil, nil
end

local queueOnTeleport, queueName = findQueueOnTeleport()

